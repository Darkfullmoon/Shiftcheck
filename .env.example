# ---------------------------------------------------------------
# Shiftcheck configuration. Copy to `.env` and adjust.
# Never commit your real `.env`.
# ---------------------------------------------------------------

# Database (docker-compose.yml starts MySQL on DB_PORT)
DB_HOST=127.0.0.1
DB_PORT=3320
DB_NAME=shiftcheck
DB_USER=shiftcheck
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Timezone for timestamps, e.g. +07:00. Empty = this machine's local offset.
DB_TIMEZONE=

# Flask
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=1
PORT=8000
# Serve the app under a sub-path, e.g. /shiftcheck (leave empty for /)
URL_PREFIX=

# First admin account, created on first start if no admin exists.
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Operations
AUDIT_DEADLINE=09:15
REPORT_DEADLINE=17:00
RETENTION_MONTHS=4
PASSWORD_MAX_AGE_DAYS=90
SESSION_HOURS=24
# true = photos must be captured with the live camera (no gallery upload)
REQUIRE_LIVE_CAMERA=false

# Optional AI features (Google Gemini). Leave the key empty to disable them.
# Several keys may be given comma-separated; they are tried in order.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash
AI_FEATURES=true
DRESS_CODE_POLICY=Staff wear a clean collared company shirt or a dark blazer over a light shirt, smart trousers or skirt, and closed shoes.
# Optional folder with reference images of the approved uniform
UNIFORM_REFERENCE_DIR=
